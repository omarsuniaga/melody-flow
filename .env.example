# Firebase (cliente, prefijo VITE_ requerido por Vite; estas SÍ pueden ir en el bundle)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPIDKEY=

# Flags de desarrollo (opcionales)
# VITE_FIREBASE_EMULATOR=true
# VITE_ANALYTICS_DEBUG=true
# VITE_USE_LOCAL_ASSETS=true

# Hermes Negotiator — IMPORTANTE: esta variable NO lleva prefijo VITE_ a propósito.
# Se usa SOLO server-side, dentro de netlify/functions/hermes-negotiate.mts.
# Configúrala en el panel de Netlify (Site settings > Environment variables),
# nunca en un archivo .env que Vite pueda exponer al cliente.
ANTHROPIC_API_KEY=

# Legado (geminiService.ts / mistralService.ts) — expuestas al cliente hoy,
# es un riesgo de seguridad conocido, no reutilizar este patrón para Hermes.
# VITE_GEMINI_API_KEY=
# VITE_MISTRAL_API_KEY=
